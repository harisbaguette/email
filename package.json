{
  "name": "bluekite-mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "brand:build": "node scripts/build-brand.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/prepare-test-env.mjs && npm run db:local && npm run password:local && playwright test",
    "db:local": "wrangler d1 migrations apply bluekite-mail --local",
    "db:remote": "wrangler d1 migrations apply bluekite-mail --remote",
    "password:local": "node scripts/reset-password.mjs --local",
    "password:reset": "node scripts/reset-password.mjs --remote",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "check:ui": "node scripts/check-ui.mjs",
    "check": "npm test && npm run build",
    "format:ui": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "prebuild": "npm run check:ui"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@radix-ui/react-select": "^2.3.8",
    "bcryptjs": "^3.0.3",
    "domutils": "^4.0.2",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.52.0",
    "postal-mime": "^4.0.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^8.0.7",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.63.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
